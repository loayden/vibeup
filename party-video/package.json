{
  "name": "party-video",
  "version": "1.0.0",
  "description": "VIBEUP party promo reel",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.470",
    "@remotion/media": "^4.0.470",
    "@remotion/tailwind-v4": "4.0.470",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.470",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.470",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render PartyFilm out/party-film.mp4",
    "render:cartoon": "remotion render BedouinCartoonFestival ../output/bedouin-white-party-cartoon-festival.mp4",
    "render:cartoon3d": "remotion render BedouinCartoonFestival3D ../output/bedouin-white-party-cartoon-festival-3d-characters.mp4",
    "still:cartoon": "remotion still BedouinCartoonFestival ../output/bedouin-white-party-cartoon-festival-frame.png --frame=690",
    "still:cartoon3d": "remotion still BedouinCartoonFestival3D ../output/bedouin-white-party-cartoon-festival-3d-characters-frame.png --frame=690",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
